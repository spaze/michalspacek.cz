<?xml version="1.0"?>
<psalm
	errorLevel="2"
	autoloader="tests/bootstrap.php"
	resolveFromConfigFile="true"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
	findUnusedBaselineEntry="true"
	findUnusedCode="true"
	findUnusedPsalmSuppress="true"
	maxStringLength="2600"
>
	<projectFiles>
		<directory name="." />
		<ignoreFiles>
			<directory name="temp" />
			<directory name="vendor" />
			<directory name="../dev-tools" />
		</ignoreFiles>
	</projectFiles>
	<fileExtensions>
		<extension name="php"/>
		<extension name="phpt"/>
	</fileExtensions>
	<enableExtensions>
		<extension name="simplexml"/>
	</enableExtensions>
	<universalObjectCrates>
		<class name="MichalSpacekCz\Templating\DefaultTemplate"/>
		<class name="Nette\Database\Row"/>
		<class name="Nette\Database\Table\ActiveRow"/>
		<class name="Nette\Utils\ArrayHash"/>
	</universalObjectCrates>
	<stubs>
		<file name="stubs/Nette/Application/UI/Component.phpstub"/>
		<file name="stubs/Nette/DI/Container.phpstub"/>
	</stubs>
	<plugins>
		<plugin filename="../dev-tools/vendor/spaze/psalm-plugin-nette/src/Plugin.php"/> <!-- Loaded by the path to its file because psalm.phar is installed in dev-tools/ and loads plugins before the autoloader above -->
	</plugins>
	<issueHandlers>
		<DeprecatedInterface>
			<errorLevel type="suppress">
				<referencedClass name="Nette\Database\IRowContainer"/> <!-- MichalSpacekCz\Test\Database\ResultSet implements Nette\Database\ResultSet which in turn implements IRowContainer for backwards compatibility -->
				<referencedClass name="Nette\Localization\ITranslator"/> <!-- MichalSpacekCz\Test\NoOpTranslator implements Contributte\Translation\Translator which in turn implements the deprecated Nette\Localization\ITranslator -->
				<referencedClass name="Nette\Security\IAuthenticator"/> <!-- MichalSpacekCz\User\Manager implements Nette\Security\Authenticator which in turn extends Nette\Security\IAuthenticator for backwards compatibility -->
			</errorLevel>
		</DeprecatedInterface>
		<DeprecatedProperty>
			<errorLevel type="suppress">
				<referencedProperty name="Texy\Modules\FigureModule::$widthDelta"/> <!-- Deprecated in Texy 3.2.8, but needed to avoid adding inline style to figure elements -->
			</errorLevel>
		</DeprecatedProperty>
		<InternalMethod>
			<errorLevel type="suppress">
				<referencedMethod name="Nette\ComponentModel\Component::setParent" /> <!-- Used in tests -->
			</errorLevel>
		</InternalMethod>
		<PossiblyInvalidArgument>
			<errorLevel type="suppress">
				<referencedFunction name="Nette\Forms\Controls\TextInput::addRule" /> <!-- nette/forms types a validator as callable(never, never) so that it takes a callable with any parameter types, Psalm reads that as a mismatch with the callable(Control) we pass -->
				<referencedFunction name="Nette\Forms\Controls\TextArea::addRule" /> <!-- the same -->
			</errorLevel>
		</PossiblyInvalidArgument>
		<PossiblyUnusedReturnValue>
			<errorLevel type="suppress">
				<file name="src/Form/Controls/TrainingControlsFactory.php" /> <!-- Keep all add<Field>() methods similar and return even if not used -->
				<file name="src/Training/Applications/TrainingApplicationStorage.php" /> <!-- Keep addPreliminaryInvitation() similar to the other methods and return even if not used -->
				<file name="src/Training/Dates/TrainingDates.php" /> <!-- Keep add() similar to other methods and return even if not used -->
			</errorLevel>
		</PossiblyUnusedReturnValue>
		<PropertyNotSetInConstructor>
			<errorLevel type="suppress">
				<file name="src/Application/ContainerSecretsChecker.php"/> <!-- $compiler, $name and $initialization are declared by Nette\DI\CompilerExtension and set by Compiler::addExtension() right after construction -->
			</errorLevel>
		</PropertyNotSetInConstructor>
	</issueHandlers>
</psalm>
