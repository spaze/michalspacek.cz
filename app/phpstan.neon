parameters:
	tmpDir: /tmp/phpstan/michalspacek.cz
	paths:
		- src
		- bin
		- public
		- tests
	fileExtensions:
		- php
		- phpt
	level: max
	checkMissingOverrideMethodAttribute: true
	bootstrapFiles:
		- ../dev-tools/vendor/autoload.php
	ignoreErrors:
		- # nette/utils declares `Html::text()` and `Html::html()` with `@method static` in the class docblock, which phpstan-nette's own stub of the class replaces, and its reflection extension then takes any method name for a fluent attribute setter, an instance method; drop once phpstan-nette knows the two, https://github.com/phpstan/phpstan-nette/pull/235
			message: '#^Static call to instance method Nette\\Utils\\Html::(text|html)\(\)\.$#'
			identifier: method.staticCall
		- # The getId() and getData() methods are called on a SimpleIdentity object, but are defined in a deprecated Identity class
			identifier: method.deprecatedClass
			path: tests/User/ManagerTest.phpt
			count: 2
		- # The id property is accessed on a SimpleIdentity object, but is defined in a deprecated Identity class
			identifier: property.deprecatedClass
			path: tests/User/ManagerTest.phpt
			count: 1
		- # Deprecated in Texy 3.2.8, but needed to avoid adding inline style to figure elements
			identifier: property.deprecated
			path: src/Formatter/TexyFormatter.php
			count: 1

includes:
	- phar://phpstan.phar/conf/bleedingEdge.neon
	- ../dev-tools/vendor/phpstan/phpstan-nette/extension.neon
	- ../dev-tools/vendor/phpstan/phpstan-nette/rules.neon
	- disallowed-calls.neon
	- ../dev-tools/vendor/phpstan/phpstan-deprecation-rules/rules.neon
	- vendor/composer/pcre/extension.neon
	- ../dev-tools/vendor/phpstan/phpstan-strict-rules/rules.neon
	- dead-code-detector.neon
