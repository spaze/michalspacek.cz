parameters:
	locales:
		all: [cs_CZ, en_US]
		languages:
			cs_CZ:
				code: cs
				name: Česky
			en_US:
				code: en
				name: English
		supported:
			# The value is a FQDN if it ends with a dot, otherwise the rootDomainMapping.$value domain is appended to the host name
			admin:
				cs_CZ: cz
			api:
				en_US: cz
			heartbleed:
				en_US: cz
			pulse:
				en_US: cz
			securitytxtvalidator:
				en_US: securitytxtvalidator.com.
			upc:
				en_US: upcwifikeys.com.
			www:
				cs_CZ: cz
				en_US: com
		rootDomainMapping:
			cz: michalspacek.cz
			com: michalspacek.com
	domain:
		sharedStaticRoot: https://www.%domain.root%
		imagesRoot: i/images
		locationRoot: /srv/www/michalspacek.cz/app/public/www.michalspacek.cz
	securityTxtDirs:
			upcwifikeys.com: upcwifikeys.com
			www.michalspacek.com: www.michalspacek.com
			www.michalspacek.cz: www.michalspacek.cz
	reporting:
		contentSecurityPolicy: https://plz.report-uri.com/r/default/csp/enforce
		reportingApi: https://plz.report-uri.com/a/d/g
	vatRate: 0.21
	loadCompanyDataVisible: true
	trainingFiles:
		# The file's real type is not verified, only the extension. Images are saved under the extension
		# detected from their content, so list them as jpeg (not jpg), png, gif, webp
		allowedExtensions: [7z, docx, gif, gz, jpeg, odp, ods, odt, pdf, png, pptx, tar, tgz, txt, webp, xlsx, zip]
	permanentLogin:
		interval: 14 days
	session:
		tableName: sessions
	authentication:
		tables:
			passkeys: passkeys
			users: users
		passkeys:
			rpId:
			rpName:
			origin:
			registrationEnabled: false
			registrationTtl: 5 minutes
			reauthTtl: 5 minutes
	certificatesApi:
		hideExpiredAfter: 10
	blog:
		updatedInfoThreshold: 30
		allowedTags:
			forms:
				form: [action, method, target]
				button: []
				input: [type, name, value]
	securityTxtValidator:
		userAgent: spaze/security-txt
		policyCacheTtl: "5 minutes"
		policyCacheClearableAfter: "30 seconds"
		lambdaStage: "prod"
		gnupgHome: /home/keymaker/.gnupg
		accountFeatureEnabled: false

	# Added/changed in local.neon
	contact:
		phoneNumber: "123456789"
	mail:
		securityNotificationsFrom: "Foo <foo@bar.example>"
		trainingFrom: "Bar <bar@qux.example>"
	# Declares the shape only, keep every value here empty and put the real ones in config/secrets.neon:
	# a value filled in here gets compiled into the container in temp/
	secrets:
		encryptionKeys:
			email: []
			session: []
			securityEvent: []
		awsLambdaApiKeys:
			upcKeys:
			securityTxtValidator:
		certificatesApiUsers: []
		mail:
			password:
		database:
			default:
				password:
			upcKeys:
				password:
			pulse:
				password:
			securityTxtValidator:
				password:
	encryption:
		activeKeyIds:
			email: ""
			session: ""
			securityEvent: ""
		keyPrefixes:
			email: ""
			session: ""
			securityEvent: ""
	awsLambda:
		upcKeys:
			url:
		securityTxtValidator:
			accessKeyId:
			region:
