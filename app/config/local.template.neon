di:
	debugger: true

mail:
	smtp: true
	host: localhost
	port: 2525
	username: ''
	password: %secrets.mail.password%

contentSecurityPolicy: # list values here are added to the existing list values, they do not replace them, unless the directive ends with !
	policies:
		*.*:
			require-trusted-types-for:
		www.*.*:
			img-src:
				- 'data:'
			style-src!:
				- %domain.contentSecurityPolicySelf%
				- "'report-sample'"
				- "'unsafe-inline'"
			require-trusted-types-for!:
		admin.*.*:
			script-src:
				-"'self'"
		admin.info.php:
			@extends: www.*.*
			script-src:
				- "'self'"
		api.*.*:
			img-src:
				- 'data:'
			script-src:
				- "'self'"
			style-src:
				- "'unsafe-inline'"
			require-trusted-types-for:
		pulse.*.*:
			script-src:
				-"'self'"
		upckeys.*.*:
			script-src:
				-"'self'"

database:
	default:
		user: dev_user # the password is in secrets.neon, see secrets.template.neon
	upcKeys:
		user: dev_user
	pulse:
		user: dev_user

parameters:
	locales:
		supported:
			upc:
				en_US: upcwifikeys.com.test.
		rootDomainMapping:
			cz: michalspacek.cz.test
			com: michalspacek.com.test

	securityTxtDirs:
			www.michalspacek.cz.test: www.michalspacek.cz

	mail:
		securityNotificationsFrom: "Fred <fred@waldo.example>"
		trainingFrom: "Barney <barney@plugh.example>"

	# The keys themselves live in secrets.neon, see secrets.template.neon
	encryption:
		activeKeyIds:
			email: dev1
			session: dev1
			securityEvent: dev1
		keyPrefixes:
			email: msee
			session: msse
			securityEvent: msle

	awsLambda:
		upcKeys:
			url: "https://example.amazonaws.com/stage/upc_keys/%s/%s"

services:
	sleep: MichalSpacekCz\Test\Utils\Insomnia
	integrityPolicy: MichalSpacekCz\Http\SecurityHeaders\IntegrityPolicy\IntegrityPolicyNone
	cache.journal: \Nette\Caching\Storages\SQLiteJournal('/tmp/michalspacek.cz/journal.cz.s3db') # file-based SQLiteJournal (default in nette/caching 2.4+) throws "SQLSTATE[HY000]: General error: 10 disk I/O error" when the journal is on shared Windows drive
